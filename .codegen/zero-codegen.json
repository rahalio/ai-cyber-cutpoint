{
  "domains": [
    {
      "name": "identity",
      "enabled": true,
      "spec_path": "identity.yaml",
      "bundled_path": ".bundled/identity.json"
    },
    {
      "name": "markets",
      "enabled": true,
      "spec_path": "markets.yaml",
      "bundled_path": ".bundled/markets.json"
    },
    {
      "name": "labelling",
      "enabled": true,
      "spec_path": "labelling.yaml",
      "bundled_path": ".bundled/labelling.json"
    },
    {
      "name": "discovery",
      "enabled": true,
      "spec_path": "discovery.yaml",
      "bundled_path": ".bundled/discovery.json"
    },
    {
      "name": "interventions",
      "enabled": true,
      "spec_path": "interventions.yaml",
      "bundled_path": ".bundled/interventions.json"
    },
    {
      "name": "governance",
      "enabled": true,
      "spec_path": "governance.yaml",
      "bundled_path": ".bundled/governance.json"
    }
  ],
  "paths": {
    "project_root": ".",
    "openapi_dir": "packages/openapi-core/src",
    "bundled_dir": "packages/openapi-core/src/.bundled",
    "output": {
      "core": {
        "base": "packages/core/src",
        "imports": {
          "types": "@cutpoint/core",
          "repositories": "@cutpoint/core",
          "handlers": "@cutpoint/core",
          "schemas": "@cutpoint/core",
          "validators": "@cutpoint/core",
          "converters": "@cutpoint/core",
          "shared_helpers": "@cutpoint/core/_shared/helpers",
          "shared_repositories": "@cutpoint/core/_shared/repositories",
          "shared_types": "@cutpoint/core/_shared/types"
        }
      },
      "services": {
        "base": "platform/services/src",
        "imports": {
          "types": "@cutpoint/core",
          "repositories": "@cutpoint/core",
          "handlers": "@cutpoint/core",
          "schemas": "@cutpoint/core",
          "validators": "@cutpoint/core",
          "converters": "@cutpoint/core",
          "shared_helpers": "@cutpoint/core/_shared/helpers",
          "shared_repositories": "@cutpoint/core/_shared/repositories",
          "shared_types": "@cutpoint/core/_shared/types"
        }
      },
      "adapters": {
        "base": "platform/adapters/src",
        "imports": {
          "types": "@cutpoint/core",
          "repositories": "@cutpoint/core",
          "handlers": "@cutpoint/core",
          "schemas": "@cutpoint/core",
          "validators": "@cutpoint/core",
          "converters": "@cutpoint/core",
          "shared_helpers": "@cutpoint/core/_shared/helpers",
          "shared_repositories": "@cutpoint/core/_shared/repositories",
          "shared_types": "@cutpoint/core/_shared/types"
        }
      },
      "api_server": {
        "base": "platform/api-server/src/domains"
      }
    }
  },
  "package_name": "@cutpoint/core",
  "package_scope": "@cutpoint",
  "version": "2.0.0"
}
