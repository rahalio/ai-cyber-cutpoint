{
  "info": {
    "name": "Governance API",
    "description": "Coverage, drift assurance, publication holds, and sealed evidence packages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.cutpoint.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "marketId",
      "value": ""
    },
    {
      "key": "packageId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Assurance",
      "item": [
        {
          "name": "getCoverageAssessment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/assurance/markets/{{marketId}}/coverage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assurance",
                "markets",
                "{{marketId}}",
                "coverage"
              ],
              "query": []
            },
            "description": "Get taxonomy coverage assessment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getCoverageAssessment status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.coverageAssessmentId || j.data.id; if (id) { pm.collectionVariables.set('coverageAssessmentId', id); pm.environment.set('coverageAssessmentId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getDriftAssessment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/assurance/markets/{{marketId}}/drift",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assurance",
                "markets",
                "{{marketId}}",
                "drift"
              ],
              "query": []
            },
            "description": "Get classification drift assessment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getDriftAssessment status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.driftAssessmentId || j.data.id; if (id) { pm.collectionVariables.set('driftAssessmentId', id); pm.environment.set('driftAssessmentId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "listPublicationHolds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/assurance/publication-holds?cursor={{cursor}}&limit={{limit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assurance",
                "publication-holds"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "List active publication holds"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listPublicationHolds status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.publicationHoldId || it.id; if (id) { pm.collectionVariables.set('publicationHoldId', id); pm.environment.set('publicationHoldId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Evidence",
      "item": [
        {
          "name": "sealEvidencePackage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/packages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                "packages"
              ],
              "query": []
            },
            "description": "Seal a privileged evidence package",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chainAdjudicationIds\": null,\n  \"purpose\": \"law_enforcement_referral\",\n  \"recipient\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('sealEvidencePackage status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getEvidencePackage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/packages/{{packageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                "packages",
                "{{packageId}}"
              ],
              "query": []
            },
            "description": "Get sealed evidence package with custody log"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getEvidencePackage status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.evidencePackageId || j.data.id; if (id) { pm.collectionVariables.set('evidencePackageId', id); pm.environment.set('evidencePackageId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}